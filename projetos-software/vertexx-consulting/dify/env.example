# Copie para .env e preencha antes do deploy

# Banco (SQLite leve)
DB_TYPE=sqlite
SQLITE_DB_PATH=/app/api/storage

# Redis desativado
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
CELERY_BROKER_URL=

# LLM Provider (OpenAI ou OpenRouter)
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
# Para OpenRouter: OPENAI_API_BASE=https://openrouter.ai/api/v1

# Evolution API (preencher quando conectar)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Dify
DIFY_WEB_URL=https://vertexx-dify-web.onrender.com
