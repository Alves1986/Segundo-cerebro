# Exemplo de .env para o OmniRoute no Render
# Cole estes valores nas Environment Variables do seu serviço no Render
# (ou use o render.yaml que já tem sync:false para as senhas).

# Porta (o Render injeta PORT automaticamente, mas reforça)
PORT=20128

# API key OBRIGATÓRIA na nuvem (não deixe o gateway aberto)
# GERADA: FRUsGepiD47OB2DusGEWVbtLslLScEJ0cAkDV8deNzs
OMNIROUTE_API_KEY=FRUsGepiD47OB2DusGEWVbtLslLScEJ0cAkDV8deNzs

# Senha do dashboard web (definida via omniroute reset-password)
INITIAL_PASSWORD=Deusamou2026@

# Se necessário, descomente para pular native build no Render:
# OMNIROUTE_SKIP_POSTINSTALL=1
